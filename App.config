<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <!-- Only used once to auto-migrate keys into the new encrypted store (%AppData%\FileScanTool\settings.dat).
         From now on, enter/edit keys via the Settings screen (right-click the pill) - no need to edit this file anymore. -->
    <appSettings>
        <add key="VirusTotalApiKey" value="" />
        <add key="MetaDefenderApiKey" value="" />
        <add key="OpenTipApiKey" value="" />
    </appSettings>
</configuration>